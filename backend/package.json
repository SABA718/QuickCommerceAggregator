{
  "name": "dealdock-api",
  "version": "1.0.0",
  "private": true,
  "description": "DealDock grocery comparison API",
  "main": "server.js",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "lint": "oxlint --deny-warnings server.js seedDatabase.js src test",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "test": "node --test test/*.test.js",
    "seed": "node seedDatabase.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.0",
    "apify-client": "^2.23.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "groq-sdk": "^1.3.0",
    "helmet": "^8.1.0",
    "pino": "^10.1.0",
    "redis": "^6.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.0",
    "oxlint": "^1.69.0",
    "supertest": "^7.2.2",
    "typescript": "^5.9.3"
  }
}
