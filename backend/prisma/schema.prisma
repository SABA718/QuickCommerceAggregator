generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. Your App's Master Product List
model CanonicalProduct {
  id             String            @id @default(uuid())
  name           String
  brand          String?
  volumeWeight   String?           // e.g., "500ml", "1kg"
  category       String?
  imageUrl       String?
  mappings       PlatformMapping[]
  createdAt      DateTime          @default(now())
}

// 2. The Deep Link Engine (Maps your product to Blinkit/Zepto IDs)
model PlatformMapping {
  id                 String           @id @default(uuid())
  canonicalProductId String
  canonicalProduct   CanonicalProduct @relation(fields: [canonicalProductId], references: [id])
  platformName       String           // "Blinkit", "Zepto", "Instamart"
  platformProductId  String           // The hidden ID used for Deep Linking
  deepLinkTemplate   String?          
  ledgers            PriceStockLedger[]

  @@unique([platformName, platformProductId]) // Prevent duplicates
}

// 3. The Hyper-Local Context
model DarkStore {
  id           String            @id @default(uuid())
  platformName String
  storeId      String            // e.g., Zepto's internal ID for Indiranagar
  pincode      String
  latitude     Float?
  longitude    Float?
  ledgers      PriceStockLedger[]

  @@unique([platformName, storeId])
}

// 4. The High-Frequency Volatile Data (Updated by Playwright Scrapers)
model PriceStockLedger {
  id                String          @id @default(uuid())
  mappingId         String
  mapping           PlatformMapping @relation(fields: [mappingId], references: [id])
  storeId           String
  store             DarkStore       @relation(fields: [storeId], references: [id])
  
  currentPrice      Float
  originalMrp       Float?
  isInStock         Boolean         @default(true)
  deliveryTimeMins  Int?
  
  // This JSONB column stores the messy, raw data exactly as Blinkit/Zepto sent it, 
  // just in case we need to debug or extract more info later!
  rawPlatformData   Json?           

  lastScrapedAt     DateTime        @default(now()) @updatedAt

  @@index([mappingId, storeId]) // Crucial for ultra-fast database searches
}