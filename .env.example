# Copy to .env for Docker Compose; never commit populated files.
# Required public hostname and exactly matching browser origin (no trailing slash).
APP_DOMAIN=dealdock.example.com
TLS_EMAIL=ops@example.com
FRONTEND_URL=https://dealdock.example.com
IMAGE_TAG=local

# External Supabase project. This MUST be a server-only service_role / secret key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=
# Only needed by psql for applying migrations, not by the application.
DATABASE_URL=

# Generate each value independently with: openssl rand -hex 32
# Use hex for REDIS_PASSWORD so it is safe inside a redis:// URL. Never reuse these secrets.
REDIS_PASSWORD=
SESSION_SECRET=
AI_SERVICE_TOKEN=

# Required to enable SMS sign-in; absent credentials produce a clear 503.
TEXTBEE_DEVICE_ID=
TEXTBEE_API_KEY=

# Required for live retailer prices. Validate the actor's output and geographic scope.
APIFY_TOKEN=
APIFY_ACTOR_ID=zangscraper/blinkit-zepto-apify-actor
# Required for recipe ingredient generation.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Required for regional translation and natural-language grocery lists.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional tuning; defaults are shown.
OTP_EXPIRY_SECONDS=300
OTP_RESEND_SECONDS=30
OTP_MAX_ATTEMPTS=5
SESSION_TTL_SECONDS=604800
CACHE_TTL_SECONDS=21600
NEGATIVE_CACHE_SECONDS=300
SCRAPE_TIMEOUT_SECONDS=90
LOG_LEVEL=info
AI_HTTP_TIMEOUT_SECONDS=20
CATALOG_CACHE_SECONDS=60

# Local non-Docker development only; Compose sets these itself.
NODE_ENV=development
PORT=3000
TRUST_PROXY=0
# Compose uses 2 (Caddy -> nginx -> API). Keep the API private; never trust client-supplied forwarding headers directly.
REDIS_URL=redis://127.0.0.1:6379
AI_SERVICE_URL=http://127.0.0.1:8000
